rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Print document uploads ────────────────────────────────────────────────
    // Files stored at: printFiles/{queueId}/{filename}
    // Open for now. TODO: lock down when Firebase Auth is added:
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null
    //     && request.resource.size < 25 * 1024 * 1024
    //     && request.resource.contentType.matches('application/(pdf|msword|vnd\\..*|octet-stream)|text/.*');
    match /printFiles/{queueId}/{filename} {
      allow read, write: if true;
    }

  }
}
